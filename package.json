{
  "name": "mern-ecommerce",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
